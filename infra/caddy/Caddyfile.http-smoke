# DNS-free HTTP-only smoke configuration.
# Explicit http:// host block keeps automatic HTTPS/ACME off.
# Pre-cutover Host-header smoke only.

http://weltgewebe.net {
	handle /health/proxy {
		respond 200
	}

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle /health/* {
		reverse_proxy api:8080
	}

	handle {
		respond "dns-free smoke only" 404
	}
}
