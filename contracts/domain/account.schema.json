{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://weltgewebe.org/schemas/domain/account.schema.json",
  "title": "Garnrolle",
  "description": "Exactly one Garnrolle per account. Map visibility and location are properties, not separate identity modes.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "type": {"const": "garnrolle"},
    "map_state": {
      "type": "string",
      "enum": ["not_on_map", "exact", "radius"],
      "description": "Public map state. not_on_map may retain an internal private location but exposes no public_pos."
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "location": {
      "type": "object",
      "description": "Internal exact location. Required for exact and radius, optional for not_on_map, and never copied directly into public output.",
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "required": ["lat", "lon"],
      "additionalProperties": false
    },
    "public_pos": {
      "type": "object",
      "description": "Public projection calculated from location and radius_m. Forbidden for not_on_map.",
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "required": ["lat", "lon"],
      "additionalProperties": false
    },
    "radius_m": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Public fuzziness radius. Positive only for radius."
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    }
  },
  "required": ["id", "type", "map_state", "title"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"map_state": {"const": "not_on_map"}}, "required": ["map_state"]},
      "then": {
        "properties": {"radius_m": {"const": 0}},
        "not": {"required": ["public_pos"]}
      }
    },
    {
      "if": {"properties": {"map_state": {"const": "exact"}}, "required": ["map_state"]},
      "then": {
        "required": ["location"],
        "properties": {"radius_m": {"const": 0}}
      }
    },
    {
      "if": {"properties": {"map_state": {"const": "radius"}}, "required": ["map_state"]},
      "then": {
        "required": ["location", "radius_m"],
        "properties": {"radius_m": {"type": "integer", "minimum": 1}}
      }
    }
  ]
}
