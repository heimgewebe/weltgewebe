{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://weltgewebe.org/schemas/domain/conversation.schema.json",
  "title": "Conversation",
  "description": "The single public conversation space belonging to a node.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_type": {
      "type": "string",
      "const": "node"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "const": "public"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "conversation_type",
    "node_id",
    "visibility",
    "created_at",
    "updated_at",
    "deleted_at"
  ],
  "additionalProperties": false
}
