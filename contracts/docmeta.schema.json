{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Canonical DocMeta schema for every document registered in manifest/repo-index.yaml. Document class, canonicality and lifecycle are separate axes; relations are typed paths.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "canonical",
        "active",
        "deprecated",
        "draft"
      ]
    },
    "doc_type": {
      "type": "string",
      "minLength": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "relates_to",
              "depends_on",
              "supersedes",
              "implements",
              "verifies",
              "derived_from",
              "contradicts"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "target"
        ],
        "additionalProperties": false
      },
      "description": "Canonical relation mechanism. Each entry is a typed relationship to a target document (repo-root-relative path)."
    },
    "role": {
      "type": "string",
      "enum": [
        "norm",
        "reality",
        "runbooks",
        "action"
      ],
      "description": "Zone-specific: document role within the zone hierarchy."
    },
    "organ": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "description": "Zone-specific: organizational unit."
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Canonical dependency field: document IDs this document depends on. An empty list means no dependencies."
    },
    "verifies_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zone-specific: scripts that verify this document."
    },
    "audit_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonicality": {
      "type": "string",
      "enum": [
        "normative",
        "reality",
        "operational",
        "supporting",
        "diagnostic",
        "navigation",
        "generated"
      ],
      "description": "How the document participates in the repository truth model."
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "archived"
      ],
      "description": "Lifecycle independent of document class and canonicality."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "description": "Accountable repository organ or product area."
    },
    "review_after": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Latest date by which the document must be reviewed again."
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "summary",
    "depends_on",
    "verifies_with",
    "role",
    "organ",
    "last_reviewed",
    "canonicality",
    "lifecycle_state",
    "owner",
    "review_after"
  ],
  "additionalProperties": false
}
