{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weltgewebe.net/contracts/federation/v1/cell-descriptor.schema.json",
  "title": "Weltgewebe Federation Cell Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "cell_id",
    "public_base_url",
    "active_key",
    "capabilities"
  ],
  "properties": {
    "protocol_version": { "const": "wg-federation/1" },
    "cell_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,62}[a-z0-9]$"
    },
    "public_base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "active_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key"],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "algorithm": { "const": "Ed25519" },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
