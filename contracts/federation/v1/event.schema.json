{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weltgewebe.net/contracts/federation/v1/event.schema.json",
  "title": "Weltgewebe Federation Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "event_id",
    "event_type",
    "origin_cell_id",
    "actor",
    "object_address",
    "object_kind",
    "object_version",
    "previous_version",
    "created_at",
    "scope",
    "neighbourhood_targets",
    "payload",
    "key_id",
    "signature"
  ],
  "properties": {
    "protocol_version": { "const": "wg-federation/1" },
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "enum": ["object.upserted", "object.deleted"] },
    "origin_cell_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,62}[a-z0-9]$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "object_address": {
      "type": "string",
      "pattern": "^wg://[a-z0-9][a-z0-9.-]{1,62}[a-z0-9]/(node|edge|shared-room)/[A-Za-z0-9._~-]{1,128}$"
    },
    "object_kind": { "enum": ["node", "edge", "shared-room"] },
    "object_version": { "type": "integer", "minimum": 1 },
    "previous_version": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}([0-9]{3}([0-9]{3})?)?)?Z$"
    },
    "scope": { "enum": ["neighbourhood", "global"] },
    "neighbourhood_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]{1,62}[a-z0-9]$"
      }
    },
    "payload": {},
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "object.upserted" } } },
      "then": { "properties": { "payload": { "type": "object" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "object.deleted" } } },
      "then": { "properties": { "payload": { "type": "null" } } }
    },
    {
      "if": { "properties": { "scope": { "const": "global" } } },
      "then": { "properties": { "neighbourhood_targets": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "scope": { "const": "neighbourhood" } } },
      "then": { "properties": { "neighbourhood_targets": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "object_version": { "const": 1 } } },
      "then": { "properties": { "previous_version": { "type": "null" } } },
      "else": { "properties": { "previous_version": { "type": "integer", "minimum": 1 } } }
    }
  ]
}
