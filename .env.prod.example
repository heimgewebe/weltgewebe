# --- DB ---
POSTGRES_USER=welt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=weltgewebe
DATABASE_URL=postgres://welt:change_me@db:5432/weltgewebe
WELTGEWEBE_API_STARTUP_MIGRATIONS=verify-applied

# --- Domain persistence ---
# Production state for wg-prod-1: PostgreSQL is the read/write truth for
# accounts/Garnrollen, nodes and edges. JSONL is local/legacy/rollback only.
WELTGEWEBE_DOMAIN_READ_SOURCE=postgres
WELTGEWEBE_DOMAIN_ACCOUNT_WRITE_SOURCE=postgres
WELTGEWEBE_DOMAIN_NODE_WRITE_SOURCE=postgres
WELTGEWEBE_DOMAIN_EDGE_WRITE_SOURCE=postgres
WELTGEWEBE_PASSKEY_CREDENTIAL_SOURCE=postgres

# --- Static web delivery ---
# Production Caddy serves apps/web/build from the internal bind mount.
# Set by scripts/weltgewebe-up from the selected deploy commit.
WELTGEWEBE_BUILD=replace_with_deploy_short_sha

# --- Public login / auto-provisioning ---
AUTH_PUBLIC_LOGIN=1
AUTH_LOG_MAGIC_TOKEN=0
AUTH_AUTO_PROVISION=1
AUTH_AUTO_PROVISION_ROLE=weber
# `weber` requires concrete AUTH_ALLOW_EMAILS or AUTH_ALLOW_EMAIL_DOMAINS.
# Open registration may only provision `gast`; `admin` is never allowed here.
AUTH_ALLOW_EMAILS=
# AUTH_ALLOW_EMAIL_DOMAINS=example.org
AUTH_RL_IP_PER_MIN=5
AUTH_RL_IP_PER_HOUR=30
AUTH_RL_EMAIL_PER_MIN=2
AUTH_RL_EMAIL_PER_HOUR=10
AUTH_COOKIE_SECURE=1

# Caddy reaches the API over the Compose bridge. Keep this explicit so
# forwarded client-IP handling is an operator decision, not an implicit default.
AUTH_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
APP_BASE_URL=https://weltgewebe.net

# --- SMTP for magic-link login ---
# Fill these in the deployed secret env file only.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_AUTH=on
SMTP_USER=replace_in_runtime_secret_env
SMTP_PASS=replace_in_runtime_secret_env
SMTP_FROM=noreply@weltgewebe.net

# --- Passkeys / WebAuthn ---
WEBAUTHN_RP_ID=weltgewebe.net
WEBAUTHN_RP_ORIGIN=https://weltgewebe.net
WEBAUTHN_RP_NAME=Weltgewebe

# --- Logging ---
RUST_LOG=info

# --- API ---
API_BIND=0.0.0.0:8080

# --- Seeding ---
# Demo sample data (development only). Set to true to seed demo data on startup if missing.
# GEWEBE_SEED_DEMO=true
#
# Real initial account bootstrap. Idempotent (skips if metadata file already exists).
# For a real deployment set GEWEBE_SEED_REAL=true and keep GEWEBE_SEED_DEMO=false.
# Also set the required bootstrap fields below.
# GEWEBE_SEED_REAL=true
#
# Required when GEWEBE_SEED_REAL=true:
# ACCOUNT_TITLE=Alice
# PUBLIC_LAT=53.5503
# PUBLIC_LON=9.9932
#
# Optional bootstrap fields (account is always a Garnrolle; map_state governs map visibility):
# ACCOUNT_ID=             # auto-generated if empty
# ACCOUNT_SUMMARY=
# ACCOUNT_ROLE=admin      # first real bootstrap account should be admin; later accounts via API
# ACCOUNT_TAGS=real
# ACCOUNT_EMAIL=
