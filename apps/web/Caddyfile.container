{
	admin off
	auto_https off
}

:8080 {
	root * /srv/weltgewebe
	encode zstd gzip
	respond /healthz 200

	# Canonicalize the one legacy filename whose Svelte bootstrap otherwise
	# reloads /map.html indefinitely. Preserve the original query verbatim.
	@legacyMapHtml path /map.html
	redir @legacyMapHtml /map{?query} 308
	try_files {path} {path}/ /index.html
	file_server
	header {
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
}
